# Internal alert configuration (committed by request)
# NOTE: This file may contain sensitive webhook/email targets.
# Use only for private/internal repositories.

ROMAR_ALERT_WINDOW_MIN=15
ROMAR_ALERT_RATE_LIMIT=20
ROMAR_ALERT_ACCESS_DENIED=20
ROMAR_ALERT_LOGIN_FAILED=30
ROMAR_ALERT_FAIL=1

# generic | slack | teams
ROMAR_ALERT_CHANNEL=generic

# Real notification targets (set when ready)
ROMAR_ALERT_WEBHOOK_URL=
ROMAR_ALERT_EMAIL_TO=

# Incident ownership
ROMAR_INCIDENT_OWNER=unassigned

# Optional JSON report output path
ROMAR_ALERT_OUTPUT_JSON=security-alert-report.json

# Log archive purge policy
ROMAR_LOG_ARCHIVE_RETENTION_DAYS=30
