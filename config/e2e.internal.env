# Internal E2E config (no GitHub Secrets required)
# Default off for public/GitHub-hosted CI.
# Set ROMAR_E2E_ENABLE=1 in a private environment when the test DB is reachable.

ROMAR_E2E_ENABLE=0

# Dedicated test DB (recommended)
ROMAR_TEST_DB_HOST=192.168.2.99
ROMAR_TEST_DB_USER=root
ROMAR_TEST_DB_PASS=
ROMAR_TEST_DB_NAME=romar_dormitory
