## Romar environment template (never commit real secrets)
# Copy this file to `.env` in each environment and replace the placeholders.
# Keep production secrets (passwords, tokens, API keys) in your secret manager or vault.
# Run your environment lint (if you have one) before committing to ensure no credentials are leaked.

# Core application settings
ROMAR_DB_HOST=localhost
ROMAR_DB_USER=root
ROMAR_DB_PASS=
ROMAR_DB_NAME=romar_dormitory
ROMAR_APP_DEBUG=0
ROMAR_APP_ENV=development
ROMAR_LOG_MAX_BYTES=5242880
ROMAR_LOG_MAX_FILES=10
ROMAR_SKIP_DB_BOOT=0

# Alert thresholds (used by tests/security_alert_check.php)
ROMAR_ALERT_WINDOW_MIN=15
ROMAR_ALERT_RATE_LIMIT=20
ROMAR_ALERT_ACCESS_DENIED=20
ROMAR_ALERT_LOGIN_FAILED=30
ROMAR_ALERT_FAIL=0
ROMAR_ALERT_CHANNEL=generic
ROMAR_ALERT_EMAIL_TO=alert@example.com
ROMAR_ALERT_WEBHOOK_URL=
ROMAR_INCIDENT_OWNER=team-it@example.com
ROMAR_LOG_ARCHIVE_RETENTION_DAYS=30

# Operational folders (ensure these directories exist and are writable)
ROMAR_DB_BACKUP_DIR=database/backups
ROMAR_DB_BACKUP_RETENTION_DAYS=14
ROMAR_DB_BACKUP_ARCHIVE_DAYS=7
ROMAR_DB_BACKUP_MAX_ACTIVE=3
ROMAR_MYSQL_BIN=C:/xampp/mysql/bin/mysql.exe
ROMAR_MYSQLDUMP_BIN=C:/xampp/mysql/bin/mysqldump.exe

# Backup alerting (set to `1` only when email infra is configured)
ROMAR_BACKUP_EMAIL_ON_FAILURE=0
ROMAR_BACKUP_EMAIL_TO=admin@example.com

# Performance settings
ROMAR_CACHE_TTL=3600
ROMAR_QUERY_TIMEOUT=30
ROMAR_MAX_RESULTS_PER_PAGE=50

# API configuration
ROMAR_API_RATE_LIMIT=60
ROMAR_API_RATE_WINDOW=60
ROMAR_CORS_ORIGINS=*

# Email settings (notifications)
ROMAR_MAIL_HOST=smtp.example.com
ROMAR_MAIL_PORT=587
ROMAR_MAIL_USERNAME=noreply@example.com
ROMAR_MAIL_PASSWORD=
ROMAR_MAIL_FROM=noreply@example.com
ROMAR_MAIL_FROM_NAME=Romar System
ROMAR_NOTIFICATION_EMAIL_TO=admin@example.com
ROMAR_NOTIFICATION_SLACK_WEBHOOK=
