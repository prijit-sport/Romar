# Production Environment Template - Copy to .env and customize
ROMAR_APP_ENV=production
ROMAR_APP_DEBUG=0

# Database (update with your prod DB)
ROMAR_DB_HOST=localhost
ROMAR_DB_USER=romar_prod
ROMAR_DB_PASS=your_secure_password
ROMAR_DB_NAME=romar_dormitory_prod

# Optional: Log retention
ROMAR_LOG_MAX_BYTES=10485760  # 10MB
ROMAR_LOG_MAX_FILES=30
ROMAR_LOG_ARCHIVE_RETENTION_DAYS=90

# Alerts (customize webhook/email)
ROMAR_ALERT_WEBHOOK_URL=https://hooks.slack.com/services/xxx/yyy/zzz
ROMAR_ALERT_EMAIL_TO=admin@romar.com
ROMAR_INCIDENT_OWNER=devops@romar.com

