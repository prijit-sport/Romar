ROMAR_APP_ENV=prod
ROMAR_APP_DEBUG=0

# Database (required)
ROMAR_DB_HOST=127.0.0.1
ROMAR_DB_USER=romar_user
ROMAR_DB_PASS=change_me
ROMAR_DB_NAME=romar_dormitory

# Security log retention (optional overrides)
ROMAR_LOG_MAX_BYTES=20971520
ROMAR_LOG_MAX_FILES=30

# Alert thresholds
ROMAR_ALERT_WINDOW_MIN=15
ROMAR_ALERT_RATE_LIMIT=20
ROMAR_ALERT_ACCESS_DENIED=20
ROMAR_ALERT_LOGIN_FAILED=30
ROMAR_ALERT_FAIL=1
ROMAR_ALERT_CHANNEL=teams
ROMAR_ALERT_EMAIL_TO=security-alerts@example.com
ROMAR_INCIDENT_OWNER=oncall-it@example.com
ROMAR_LOG_ARCHIVE_RETENTION_DAYS=30

# Optional webhook for alert notifications (Slack/Teams/Discord/custom)
ROMAR_ALERT_WEBHOOK_URL=https://example.com/webhook
